FROM node:24-alpine AS base

RUN apk add --no-cache openssl \
    && corepack enable

WORKDIR /app


FROM base AS dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json

RUN pnpm install --frozen-lockfile


FROM dependencies AS build

COPY biome.json ./
COPY .gitignore ./

COPY backend/package.json ./backend/package.json
COPY backend/tsconfig.json ./backend/tsconfig.json
COPY backend/prisma7.config.ts ./backend/prisma7.config.ts
COPY backend/prisma ./backend/prisma
COPY backend/src ./backend/src
COPY backend/tests ./backend/tests

WORKDIR /app/backend

# O Prisma precisa de uma URL válida para carregar sua configuração,
# mas o prisma generate não acessa esse banco.
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" \
    pnpm run build


FROM base AS runtime

ENV NODE_ENV=production

WORKDIR /app

COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/backend/node_modules ./backend/node_modules

COPY --from=build /app/backend/package.json ./backend/package.json
COPY --from=build /app/backend/dist ./backend/dist
COPY --from=build /app/backend/prisma ./backend/prisma
COPY --from=build /app/backend/prisma7.config.ts ./backend/prisma7.config.ts

WORKDIR /app/backend

USER node

EXPOSE 3001

CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy --config=prisma7.config.ts && exec node dist/src/server.js"]