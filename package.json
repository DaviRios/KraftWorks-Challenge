{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test \"tests/unit/**/*.test.ts\"",
    "test:watch": "tsx --test --watch \"tests/unit/**/*.test.ts\"",
    "validate": "pnpm run test && pnpm run format",
    "prisma:generate": "prisma generate",
    "dev": "pnpm run prisma:generate && pnpm run validate && tsx watch --env-file=.env src/server.ts",
    "build": "pnpm run prisma:generate && pnpm run validate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:local": "node --env-file=.env dist/src/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.1.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.1.0",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@scalar/fastify-api-reference": "^1.67.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  }
