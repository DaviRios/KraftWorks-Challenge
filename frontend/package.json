    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@tanstack/react-query": "^5.90.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  }
}
